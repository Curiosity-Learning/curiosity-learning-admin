# Copy this file to `.env` and fill in values (see README "Setup").
#
# This app is a pure client of the shared Convex backend (the main repo,
# curiosity-learning-frontend-svelte, owns the Convex deployment, schema, and all admin
# functions). It needs only the public Convex endpoints below — no BETTER_AUTH_SECRET, Google
# client secret, or other server-side secrets, because this app has no SvelteKit server-side
# auth/session handling (see README "How auth works").

PUBLIC_CONVEX_URL=""
PUBLIC_CONVEX_SITE_URL=""

# Mapbox public token (pk.*) for the leader-invites location autocomplete + map preview. Same
# value as the main repo's PUBLIC_MAPBOX_ACCESS_TOKEN. Optional: without it the location field
# degrades to plain text (no suggestions, no map placement).
PUBLIC_MAPBOX_ACCESS_TOKEN=""
